# =============================================================================
# WDP 团队平台 · Docker 构建忽略清单
# 构建上下文：本仓库根目录（wdp-team-platform/，web-ui/ 与 agent-src/ 已随仓库自带）
# 使用方式（在仓库根）：docker build -t <tag> .
# =============================================================================

# ------- 版本控制 -------
.git
.gitignore
.gitattributes
.github
**/.git
**/.github

# ------- Hermes 运行时数据（绝不能进镜像）-------
hermes-home/
**/hermes-home/
**/.hermes/
knowledge/
**/knowledge/

# ------- Web UI 运行时产物 -------
web-ui/.env
web-ui/.env.*
!web-ui/.env.docker.example
web-ui/venv/
web-ui/.venv/
web-ui/.wdp-cache/
web-ui/**/__pycache__/
web-ui/**/*.pyc
web-ui/**/*.pyo
web-ui/.pytest_cache/
web-ui/.mypy_cache/
web-ui/.ruff_cache/
web-ui/htmlcov/
web-ui/.coverage

# ------- Agent 源码运行时产物 -------
agent-src/venv/
agent-src/.venv/
agent-src/**/__pycache__/
agent-src/**/*.pyc
agent-src/**/*.pyo
agent-src/*.egg-info/
agent-src/build/
agent-src/dist/
agent-src/.pytest_cache/
agent-src/.mypy_cache/
agent-src/.ruff_cache/
agent-src/node_modules/
agent-src/web/node_modules/
agent-src/ui-tui/node_modules/
agent-src/.env
agent-src/.env.*

# ------- Node -------
**/node_modules/

# ------- 操作系统 / 编辑器 -------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# ------- 日志 / 临时 -------
*.log
logs/
tmp/
*.tmp
*.bak

# ------- 部署自身不进镜像的部分 -------
k8s/
docs/

# ------- 但 COPY 需要的目录必须保留（否决上面的泛排除）-------
!webui-overlay/**
!team-config/**
!scripts/**

# ------- 大文件 -------
**/*.zip
**/*.tar
**/*.tar.gz
**/*.mp4
**/*.mov
